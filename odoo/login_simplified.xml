<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Botón de inicio de sesión mejorado -->
    <template id="enhanced_login_button" inherit_id="portal.placeholder_user_sign_in">
        <xpath expr="." position="inside">
            <li t-nocache="true" t-nocache-_item_class="_item_class" t-nocache-_link_class="_link_class" groups="base.group_public" t-attf-class="#{_item_class} o_no_autohide_item">
                <a t-attf-href="/web/login" t-attf-class="#{_link_class} d-flex align-items-center" style="position: relative; padding: 8px 20px; margin-left: 10px; border-radius: 50px; background: linear-gradient(135deg, #FF914D, #FF7E33); color: white !important; font-weight: 600; transition: all 0.3s ease; box-shadow: 0 4px 10px rgba(255,145,77,0.2);">
                    <i class="fa fa-user me-2" style="font-size: 0.9rem;"></i>
                    <span>Iniciar sesión</span>
                    <span t-if="request.session.profile_session" class="position-absolute" style="top: -4px; right: -4px; width: 10px; height: 10px; border-radius: 50%; background-color: #e91e63; box-shadow: 0 0 5px rgba(233,30,99,0.5);"></span>
                </a>
                <script>
                    // Script simplificado
                </script>
            </li>
        </xpath>
    </template>
    
    <template id="auth_signup_login_premium" inherit_id="web.login">
        <xpath expr="//head" position="inside">
            <!-- Estilos y fuentes -->
        </xpath>
        
        <xpath expr="//div[hasclass('container')]" position="attributes">
            <attribute name="style">max-width: 460px; padding: 60px 15px;</attribute>
        </xpath>
        
        <xpath expr="//main" position="before">
            <div class="pattern-dots"></div>
            <div class="pattern-lines"></div>
        </xpath>
        
        <xpath expr="//div[hasclass('card')]" position="attributes">
            <attribute name="style">border-radius: 24px; border: none; overflow: hidden; box-shadow: 0 15px 40px rgba(0,0,0,0.08), 0 0 0 1px rgba(255,255,255,0.1);</attribute>
        </xpath>
        
        <xpath expr="//div[hasclass('card-body')]" position="replace">
            <div class="card-body p-4">
                <!-- Contenido del formulario -->
            </div>
        </xpath>
    </template>
</odoo>
