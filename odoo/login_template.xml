<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Mejora del template de Login -->
        <template id="auth_signup_login_improved" inherit_id="web.login">
            <xpath expr="//div[@class='card-body']" position="replace">
                <!-- Fuentes personalizadas -->
                <t t-set="head">
                    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&amp;display=swap"/>
                </t>
                
                <div class="card-body p-4" style="font-family: 'Poppins', sans-serif;">
                    <!-- Encabezado del formulario de login mejorado -->
                    <div class="text-center mb-4">
                        <div style="display: inline-flex; align-items: center; justify-content: center; width: 70px; height: 70px; border-radius: 50%; background: linear-gradient(to right, #FF914D, #FF7E33); margin-bottom: 20px; box-shadow: 0 10px 25px rgba(255,145,77,0.3);">
                            <i class="fa fa-user-circle" style="color: white; font-size: 32px;"></i>
                        </div>
                        <h2 style="font-family: 'Poppins', sans-serif; font-weight: 700; color: #333; font-size: 1.8rem; margin-bottom: 10px;">Bienvenido</h2>
                        <p style="color: #666; margin-bottom: 0;">Ingrese sus credenciales para acceder a su cuenta</p>
                    </div>
                    
                    <!-- Contenedor de mensajes de alerta -->
                    <div t-if="error" class="alert alert-danger" role="alert" style="border-radius: 12px; border-left: 4px solid #dc3545; background-color: rgba(220,53,69,0.05); padding: 15px;">
                        <div class="d-flex align-items-center">
                            <i class="fa fa-exclamation-circle me-2" style="color: #dc3545; font-size: 20px;"></i>
                            <span style="color: #333; font-weight: 500;"><t t-esc="error"/></span>
                        </div>
                    </div>
                    <div t-if="message" class="alert alert-success" role="alert" style="border-radius: 12px; border-left: 4px solid #28a745; background-color: rgba(40,167,69,0.05); padding: 15px;">
                        <div class="d-flex align-items-center">
                            <i class="fa fa-check-circle me-2" style="color: #28a745; font-size: 20px;"></i>
                            <span style="color: #333; font-weight: 500;"><t t-esc="message"/></span>
                        </div>
                    </div>
                    
                    <!-- Formulario de login mejorado -->
                    <form t-if="not message" t-attf-action="/web/login" method="post" class="oe_login_form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        
                        <!-- Campo de base de datos (si hay múltiples) -->
                        <div t-if="databases and len(databases) &gt; 1" class="mb-4">
                            <div class="input-group" style="position: relative; border-radius: 12px; overflow: hidden; box-shadow: 0 3px 15px rgba(0,0,0,0.05);">
                                <div class="input-group-text" style="background-color: #f8f9fa; border: none; border-right: 1px solid #ececec;">
                                    <i class="fa fa-database" style="color: #888;"></i>
                                </div>
                                <select id="db" name="db" class="form-control form-control-lg" style="border: none; padding: 12px 15px; font-size: 1rem;">
                                    <option value="" style="color: #999;">Seleccionar base de datos</option>
                                    <t t-foreach="databases" t-as="db">
                                        <option t-if="db == request.env.cr.dbname" t-att-value="db" selected="selected" style="color: #333;"><t t-esc="db"/></option>
                                        <option t-else="" t-att-value="db" style="color: #333;"><t t-esc="db"/></option>
                                    </t>
                                </select>
                            </div>
                        </div>
                        
                        <!-- Campo de correo/login -->
                        <div class="mb-3">
                            <label for="login" class="form-label fw-bold" style="color: #333; margin-bottom: 8px;">Email o Usuario</label>
                            <div class="input-group" style="position: relative; border-radius: 12px; overflow: hidden; box-shadow: 0 3px 15px rgba(0,0,0,0.05);">
                                <div class="input-group-text" style="background-color: #f8f9fa; border: none; border-right: 1px solid #ececec;">
                                    <i class="fa fa-envelope" style="color: #888;"></i>
                                </div>
                                <input id="login" name="login" t-att-value="login" type="text" autocomplete="username" placeholder="ejemplo@correo.com" class="form-control form-control-lg" required="required" style="border: none; padding: 12px 15px; font-size: 1rem;"/>
                            </div>
                        </div>
                        
                        <!-- Campo de contraseña -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label for="password" class="form-label fw-bold" style="color: #333; margin-bottom: 0;">Contraseña</label>
                                <a t-if="reset_password_enabled" t-attf-href="/web/reset_password" style="font-size: 0.9rem; color: #FF914D; text-decoration: none; font-weight: 500;">¿Olvidó su contraseña?</a>
                            </div>
                            <div class="input-group" style="position: relative; border-radius: 12px; overflow: hidden; box-shadow: 0 3px 15px rgba(0,0,0,0.05);">
                                <div class="input-group-text" style="background-color: #f8f9fa; border: none; border-right: 1px solid #ececec;">
                                    <i class="fa fa-lock" style="color: #888;"></i>
                                </div>
                                <input id="password" name="password" type="password" autocomplete="current-password" placeholder="••••••••" class="form-control form-control-lg" required="required" style="border: none; padding: 12px 15px; font-size: 1rem;"/>
                                <div class="toggle-password input-group-text" style="background-color: #f8f9fa; border: none; border-left: 1px solid #ececec; cursor: pointer;" onclick="togglePassword()">
                                    <i class="fa fa-eye" id="toggleIcon" style="color: #888;"></i>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Botón de inicio de sesión -->
                        <button type="submit" class="btn btn-primary w-100 py-3" style="background: linear-gradient(to right, #FF914D, #FF7E33); border: none; border-radius: 12px; font-weight: 600; font-size: 1rem; box-shadow: 0 5px 15px rgba(255,145,77,0.2); transition: all 0.3s ease;">
                            <i class="fa fa-sign-in-alt me-2"></i> Iniciar Sesión
                        </button>
                        
                        <!-- Opciones adicionales -->
                        <div t-if="signup_enabled" class="text-center mt-4">
                            <p style="color: #666;">¿No tiene una cuenta?
                                <a t-attf-href="/web/signup" style="color: #FF914D; font-weight: 600; text-decoration: none;">Registrarse</a>
                            </p>
                        </div>
                    </form>
                    
                    <!-- Script para ver/ocultar contraseña -->
                    <script>
                        function togglePassword() {
                            var passwordField = document.getElementById("password");
                            var toggleIcon = document.getElementById("toggleIcon");
                            
                            if (passwordField.type === "password") {
                                passwordField.type = "text";
                                toggleIcon.classList.remove("fa-eye");
                                toggleIcon.classList.add("fa-eye-slash");
                            } else {
                                passwordField.type = "password";
                                toggleIcon.classList.remove("fa-eye-slash");
                                toggleIcon.classList.add("fa-eye");
                            }
                        }
                        
                        // Añadir efecto hover a botón de login
                        document.addEventListener('DOMContentLoaded', function() {
                            var loginBtn = document.querySelector('button[type="submit"]');
                            if (loginBtn) {
                                loginBtn.addEventListener('mouseenter', function() {
                                    this.style.transform = 'translateY(-3px)';
                                    this.style.boxShadow = '0 8px 20px rgba(255,145,77,0.3)';
                                });
                                loginBtn.addEventListener('mouseleave', function() {
                                    this.style.transform = 'translateY(0)';
                                    this.style.boxShadow = '0 5px 15px rgba(255,145,77,0.2)';
                                });
                            }
                            
                            // Mejorar campos de entrada
                            var inputs = document.querySelectorAll('.form-control');
                            inputs.forEach(function(input) {
                                input.addEventListener('focus', function() {
                                    this.parentNode.style.boxShadow = '0 3px 15px rgba(255,145,77,0.15)';
                                });
                                input.addEventListener('blur', function() {
                                    this.parentNode.style.boxShadow = '0 3px 15px rgba(0,0,0,0.05)';
                                });
                            });
                        });
                    </script>
                </div>
            </xpath>
            
            <!-- Mejora del fondo de la página de login -->
            <xpath expr="//div[hasclass('container')]" position="attributes">
                <attribute name="style">padding: 60px 0; max-width: 500px;</attribute>
            </xpath>
            
            <xpath expr="//div[@class='card']" position="attributes">
                <attribute name="style">border-radius: 24px; border: none; box-shadow: 0 15px 40px rgba(0,0,0,0.08); overflow: hidden; background: white;</attribute>
            </xpath>
            
            <!-- Añadir fondo personalizado a la página -->
            <xpath expr="//main" position="before">
                <style>
                    body {
                        background: linear-gradient(135deg, #f9f9f9 0%, #f3f3f3 100%);
                    }
                    body:before {
                        content: '';
                        position: fixed;
                        top: 0;
                        right: 0;
                        width: 300px;
                        height: 300px;
                        background: radial-gradient(circle, rgba(255,145,77,0.1) 0%, rgba(255,145,77,0) 70%);
                        z-index: -1;
                    }
                    body:after {
                        content: '';
                        position: fixed;
                        bottom: 0;
                        left: 0;
                        width: 300px;
                        height: 300px;
                        background: radial-gradient(circle, rgba(255,145,77,0.08) 0%, rgba(255,145,77,0) 70%);
                        z-index: -1;
                    }
                </style>
            </xpath>
        </template>
    </data>
</odoo>
