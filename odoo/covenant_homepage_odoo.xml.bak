<t t-name="website.homepage">
    <t t-call="website.layout">
        <div id="wrap" class="oe_structure oe_empty">
            <!-- Sección principal / Hero -->
            <section class="s_text_image o_cc o_cc1 o_colored_level pt16 pb184" data-snippet="s_text_image" data-name="Text - Image" style="background-color: #FFFFFF !important">
                
                <div class="container-fluid px-3">
                    <div class="row o_grid_mode" data-row-count="17">
                        <div class="o_colored_level o_grid_item g-col-lg-6 g-height-17 col-lg-6" style="grid-area: 1 / 1 / 18 / 7; z-index: 1;">
                            <h1 style="text-align: left; font-family: 'Poppins', sans-serif;">
                                <span style="font-weight: 700;">
                                    <span style="color: #FF914D;"><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">PACTO</font></font></span>
                                </span>
                            </h1>
                            <h2 style="text-align: left; font-family: 'Poppins', sans-serif;">
                                <span style="font-weight: 700;"><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">
                                    Iluminación </font></font><span style="color: #FF914D;"><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">Premium</font></font></span>
                                </span>
                            </h2>
                            <p style="text-align: left; font-family: 'Poppins', sans-serif;">
                                <span style="font-weight: 400;"><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">Transforma cualquier espacio con nuestras luces LED inteligentes y sistemas de iluminación profesional.</font></font></span>
                            </p>
                            <div class="media_iframe_video" data-oe-expression="//www.youtube.com/embed/G8b4UZIcTfg?rel=0&amp;autoplay=0">
                                <div class="css_editable_mode_display"/>
                                <div class="media_iframe_video_size"/>
                                <iframe src="//www.youtube.com/embed/G8b4UZIcTfg?rel=0&amp;autoplay=0" frameborder="0" allowfullscreen="allowfullscreen" aria-label="Video"/>
                            </div>
                            <div class="s_btn text-start pt16 pb16" data-name="Buttons">
                                <a href="/shop" class="btn btn-primary btn-lg mb-2 me-2" data-bs-original-title="" title="" aria-describedby="tooltip696410" style="background-color: #FF914D; border-color: #FF914D; border-radius: 50px; font-family: 'Poppins', sans-serif;">
                                    <i class="fa fa-shopping-bag me-1"/><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">EXPLORAR TIENDA
                                </font></font></a>
                                <a href="#productos" class="btn btn-outline-primary btn-lg mb-2" data-bs-original-title="" title="" aria-describedby="tooltip947449" style="border-color: #FF914D; color: #FF914D; border-radius: 50px; font-family: 'Poppins', sans-serif;"><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">Ver Catálogo
                                </font></font></a>
                            </div>
                            <div class="s_text_block pt16 pb16 o_cc o_cc1" data-snippet="s_text_block" data-name="Text">
                                <div class="d-flex flex-wrap justify-content-between">
                                    <div class="text-center me-4">
                                        <div style="color: #FF914D; font-weight: 700; font-size: 2rem; font-family: 'Poppins', sans-serif;"><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">15 mil+</font></font></div>
                                        <div style="font-family: 'Poppins', sans-serif;"><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">Clientela</font></font></div>
                                    </div>
                                    <div class="text-center me-4">
                                        <div style="color: #FF914D; font-weight: 700; font-size: 2rem; font-family: 'Poppins', sans-serif;"><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">2K+</font></font></div>
                                        <div style="font-family: 'Poppins', sans-serif;"><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">Productos</font></font></div>
                                    </div>
                                    <div class="text-center">
                                        <div style="color: #FF914D; font-weight: 700; font-size: 2rem; font-family: 'Poppins', sans-serif;"><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">24/7</font></font></div>
                                        <div style="font-family: 'Poppins', sans-serif;"><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">Soporte</font></font></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="o_colored_level o_grid_item o_grid_item_image g-height-11 g-col-lg-4 col-lg-5 offset-lg-1" style="z-index: 2; grid-area: 1 / 9 / 12 / 13;">
                            <img src="/web/image/1942-41852664/principio1.webp" class="img img-fluid mx-auto" alt="Imagen Principal" loading="lazy" style="border-radius: 8px; box-shadow: rgba(0, 0, 0, 0.1) 0px 20px 40px; transform: rotate(2deg);" data-mimetype="image/jpeg" data-original-id="1941" data-original-src="/web/image/1941-7ecf3753/principio1.jpg" data-mimetype-before-conversion="image/jpeg"/>
                        </div>
                    </div>
                </div>
            </section>
            
            <!-- Inicio barra lateral de categorías -->
            <section class="s_text_image pt40 pb40 o_cc o_cc1 o_colored_level" data-snippet="s_text_image" data-name="Categories and Content" style="background-color: #F9F9F9 !important;">
                <div class="container-fluid px-3">
                    <div class="row g-3">
                        <!-- Barra lateral de categorías - Utilizando acordeón Bootstrap nativo -->
                        <div class="col-lg-2 col-md-12 col-sm-12">
                            <div style="border-radius: 16px; box-shadow: 0 15px 35px rgba(0,0,0,0.05); background-color: #FFFFFF; padding: 20px; position: sticky; top: 100px; border-left: 4px solid #FF914D;" class="sidebar-container">
                                
                                <!-- Categorías con Accordion -->
                                <div class="accordion accordion-flush d-lg-none" id="categoriesAccordion">
                                    <div class="accordion-item border-0">
                                        <h4 class="accordion-header">
                                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#categoriesContent" aria-expanded="true" aria-controls="categoriesContent" style="font-family: 'Poppins', sans-serif; color: #2A2A2D; font-weight: bold; padding: 0 0 10px 0; background: none; box-shadow: none;">
                                                Categorías
                                            </button>
                                        </h4>
                                        <div id="categoriesContent" class="accordion-collapse collapse show" data-bs-parent="#categoriesAccordion">
                                            <div class="accordion-body p-0">
                                                <ul class="list-unstyled" style="font-family: 'Poppins', sans-serif;">
                                                    <t t-foreach="request.env['product.public.category'].sudo().search([])" t-as="category">
                                                        <li class="mb-2">
                                                            <a t-att-href="'/shop/category/%s' % slug(category)" style="display: block; padding: 8px 12px; border-radius: 8px; color: #2A2A2D; text-decoration: none; transition: all 0.3s ease;">
                                                                <i class="fa fa-angle-right me-2" style="color: #FF914D;"/>
                                                                <t t-esc="category.name"/>
                                                                <span class="float-end badge" style="background-color: rgba(255,145,77,0.1); color: #FF914D;">
                                                                    <t t-esc="env['product.template'].sudo().search_count([('public_categ_ids', 'in', category.id)])"/>
                                                                </span>
                                                            </a>
                                                        </li>
                                                    </t>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Vista desktop - sin acordeón -->
                                <div class="d-none d-lg-block">
                                    <h4 style="font-family: 'Poppins', sans-serif; color: #2A2A2D; font-weight: bold; margin-bottom: 15px; padding-bottom: 10px; border-bottom: 2px solid #FF914D;">
                                        Categorías
                                    </h4>
                                    <ul class="list-unstyled" style="font-family: 'Poppins', sans-serif;">
                                        <t t-foreach="request.env['product.public.category'].sudo().search([])" t-as="category">
                                            <li class="mb-2">
                                                <a t-att-href="'/shop/category/%s' % slug(category)" style="display: block; padding: 8px 12px; border-radius: 8px; color: #2A2A2D; text-decoration: none; transition: all 0.3s ease;">
                                                    <i class="fa fa-angle-right me-2" style="color: #FF914D;"/>
                                                    <t t-esc="category.name"/>
                                                    <span class="float-end badge" style="background-color: rgba(255,145,77,0.1); color: #FF914D;">
                                                        <t t-esc="env['product.template'].sudo().search_count([('public_categ_ids', 'in', category.id)])"/>
                                                    </span>
                                                </a>
                                            </li>
                                        </t>
                                    </ul>
                                </div>
                                
                                <!-- Filtros populares con Accordion -->
                                <div class="accordion accordion-flush d-lg-none mt-3" id="filtersAccordion">
                                    <div class="accordion-item border-0">
                                        <h5 class="accordion-header">
                                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#filtersContent" aria-expanded="true" aria-controls="filtersContent" style="font-family: 'Poppins', sans-serif; color: #2A2A2D; font-weight: bold; padding: 0 0 10px 0; background: none; box-shadow: none;">
                                                Filtros Populares
                                            </button>
                                        </h5>
                                        <div id="filtersContent" class="accordion-collapse collapse show" data-bs-parent="#filtersAccordion">
                                            <div class="accordion-body p-0">
                                                <div class="d-flex flex-wrap">
                                                    <a href="/shop?price_min=0&amp;price_max=1000" class="btn btn-sm mb-2 me-2" style="background-color: rgba(255,145,77,0.1); color: #FF914D; border-radius: 50px; font-family: 'Poppins', sans-serif;">
                                                        Hasta $1000
                                                    </a>
                                                    <a href="/shop?tags=2" class="btn btn-sm mb-2 me-2" style="background-color: rgba(255,145,77,0.1); color: #FF914D; border-radius: 50px; font-family: 'Poppins', sans-serif;">
                                                        Ofertas
                                                    </a>
                                                    <a href="/shop?tags=3" class="btn btn-sm mb-2 me-2" style="background-color: rgba(255,145,77,0.1); color: #FF914D; border-radius: 50px; font-family: 'Poppins', sans-serif;">
                                                        Nuevos
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Vista desktop - sin acordeón para filtros -->
                                <div class="d-none d-lg-block mt-4">
                                    <h5 style="font-family: 'Poppins', sans-serif; color: #2A2A2D; font-weight: bold; margin: 20px 0 12px; border-bottom: 1px solid #eee; padding-bottom: 8px;">
                                        Filtros Populares
                                    </h5>
                                    <div class="d-flex flex-wrap">
                                        <a href="/shop?price_min=0&amp;price_max=1000" class="btn btn-sm mb-2 me-2" style="background-color: rgba(255,145,77,0.1); color: #FF914D; border-radius: 50px; font-family: 'Poppins', sans-serif;">
                                            Hasta $1000
                                        </a>
                                        <a href="/shop?tags=2" class="btn btn-sm mb-2 me-2" style="background-color: rgba(255,145,77,0.1); color: #FF914D; border-radius: 50px; font-family: 'Poppins', sans-serif;">
                                            Ofertas
                                        </a>
                                        <a href="/shop?tags=3" class="btn btn-sm mb-2 me-2" style="background-color: rgba(255,145,77,0.1); color: #FF914D; border-radius: 50px; font-family: 'Poppins', sans-serif;">
                                            Nuevos
                                        </a>
                                    </div>
                                </div>
                                
                                <!-- Testimonios de Clientes con Accordion -->
                                <div class="accordion accordion-flush d-lg-none mt-3" id="testimonialsAccordion">
                                    <div class="accordion-item border-0">
                                        <h5 class="accordion-header">
                                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#testimonialsContent" aria-expanded="true" aria-controls="testimonialsContent" style="font-family: 'Poppins', sans-serif; color: #2A2A2D; font-weight: bold; padding: 0 0 10px 0; background: none; box-shadow: none;">
                                                Opiniones de Clientes
                                            </button>
                                        </h5>
                                        <div id="testimonialsContent" class="accordion-collapse collapse show" data-bs-parent="#testimonialsAccordion">
                                            <div class="accordion-body p-0">
                                                <!-- Testimonios para móvil -->
                                                <div class="mb-4 p-3" style="background-color: rgba(255,145,77,0.03); border-radius: 10px;">
                                                    <div class="d-flex align-items-center mb-2">
                                                        <div style="width: 40px; height: 40px; background-color: #FF914D; border-radius: 50%; color: white; display: flex; align-items: center; justify-content: center; font-weight: bold; margin-right: 10px;">
                                                            MR
                                                        </div>
                                                        <div>
                                                            <div style="font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 0.9rem;">María R.</div>
                                                            <div style="color: #FFD700;">★★★★★</div>
                                                        </div>
                                                    </div>
                                                    <p style="font-family: 'Poppins', sans-serif; font-size: 0.8rem; margin-bottom: 0; font-style: italic; color: #666;">
                                                        "Excelente calidad de iluminación, transformó completamente mi sala de estar."
                                                    </p>
                                                </div>
                                                
                                                <div class="mb-4 p-3" style="background-color: rgba(255,145,77,0.03); border-radius: 10px;">
                                                    <div class="d-flex align-items-center mb-2">
                                                        <div style="width: 40px; height: 40px; background-color: #FF914D; border-radius: 50%; color: white; display: flex; align-items: center; justify-content: center; font-weight: bold; margin-right: 10px;">
                                                            JP
                                                        </div>
                                                        <div>
                                                            <div style="font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 0.9rem;">Juan P.</div>
                                                            <div style="color: #FFD700;">★★★★★</div>
                                                        </div>
                                                    </div>
                                                    <p style="font-family: 'Poppins', sans-serif; font-size: 0.8rem; margin-bottom: 0; font-style: italic; color: #666;">
                                                        "Las tiras LED son increíbles, muy fáciles de instalar y el soporte técnico excelente."
                                                    </p>
                                                </div>
                                                
                                                <a href="#" class="btn btn-sm w-100" style="background-color: rgba(255,145,77,0.1); color: #FF914D; border-radius: 50px; font-family: 'Poppins', sans-serif;">
                                                    <i class="fa fa-comments me-1"/>Ver más opiniones
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Vista desktop - sin acordeón para testimonios -->
                                <div class="d-none d-lg-block mt-4">
                                    <h5 style="font-family: 'Poppins', sans-serif; color: #2A2A2D; font-weight: bold; margin: 20px 0 15px; border-bottom: 1px solid #eee; padding-bottom: 8px;">
                                        Opiniones de Clientes
                                    </h5>
                                    
                                    <div class="mb-4 p-3" style="background-color: rgba(255,145,77,0.03); border-radius: 10px;">
                                        <div class="d-flex align-items-center mb-2">
                                            <div style="width: 40px; height: 40px; background-color: #FF914D; border-radius: 50%; color: white; display: flex; align-items: center; justify-content: center; font-weight: bold; margin-right: 10px;"><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">
                                                Japón
                                            </font></font></div>
                                            <div>
                                                <div style="font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 0.9rem;"><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">Juan P.</font></font></div>
                                                <div style="color: #FFD700;"><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">★★★★★</font></font></div>
                                            </div>
                                        </div>
                                        <p style="font-family: 'Poppins', sans-serif; font-size: 0.8rem; margin-bottom: 0; font-style: italic; color: #666;"><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">
                                            "Las tiras LED son increíbles, muy fáciles de instalar y el soporte técnico excelente."
                                        </font></font></p>
                                    </div>
                                    
                                    
                                    <a href="#" class="btn btn-sm w-100" style="background-color: rgba(255,145,77,0.1); color: #FF914D; border-radius: 50px; font-family: 'Poppins', sans-serif;">
                                        <i class="fa fa-comments me-1"><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;"/></font></i><font dir="auto" style="vertical-align: inherit;"><font dir="auto" style="vertical-align: inherit;">Ver más opiniones
                                    </font></font></a>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Contenido principal - Adaptado para mejor visualización en móviles -->
                        <div class="col-lg-10 col-md-12 col-sm-12">
                            <!-- Nuestras Soluciones -->
                            <div class="s_image_gallery o_slideshow pt32 pb32 ps-lg-4" data-snippet="s_image_gallery" data-name="Image Gallery" style="background-color: #FFFFFF !important; border-radius: 16px; box-shadow: 0 15px 35px rgba(0,0,0,0.03); margin-top: 15px;">
                                <div class="s_title pb16" data-name="Title">
                                    <h2 style="text-align: center; font-family: 'Poppins', sans-serif;">
                                        <span style="background-color: rgba(255,145,77,0.1); color: #FF914D; padding: 8px 20px; border-radius: 50px; font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 1rem; text-transform: uppercase;">
                                            NUESTROS SERVICIOS
                                        </span>
                                    </h2>
                                    <h3 class="mt-3" style="text-align: center; font-family: 'Poppins', sans-serif; color: #2A2A2D; font-weight: bold; font-size: 2.5rem">
                                        Nuestros <span style="color: #FF914D;">servicios</span>
                                    </h3>
                                </div>
                                <!-- Fila asimétrica con offset reducido -->
                                <div class="row px-3">
                                    <div class="col-lg-4 pt16 pb16">
                                        <div style="box-shadow: 0 15px 35px rgba(0,0,0,0.08); border-radius: 16px; background-color: #FFFFFF; height: 100%; transform: translateY(-10px);" class="card">
                                            <div class="card-body">
                                                <h3 style="font-family: 'Poppins', sans-serif; color: #2A2A2D; font-weight: bold;">
                                                    <i class="fa fa-bolt me-2" style="color: #FF914D;"/> Materiales eléctricos
                                                </h3>
                                                <ul style="font-family: 'Poppins', sans-serif; padding-left: 1.5rem;">
                                                    <li>Cables, térmicas, disyuntores</li>
                                                    <li>Llaves, tomas, cajas</li>
                                                    <li>Iluminación LED, proyectores</li>
                                                    <li>Tuberías y canalizaciones</li>
                                                    <li>Otros</li>
                                                </ul>
                                                <div style="margin-top: 20px; text-align: center;">
                                                    <div style="color: #FF914D; font-weight: 700; font-size: 2rem; font-family: 'Poppins', sans-serif;">15K+</div>
                                                    <div style="font-family: 'Poppins', sans-serif;">Productos eléctricos</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 pt16 pb16">
                                        <div style="box-shadow: 0 15px 35px rgba(0,0,0,0.08); border-radius: 16px; background-color: #FFFFFF; height: 100%;" class="card">
                                            <div class="card-body">
                                                <h3 style="font-family: 'Poppins', sans-serif; color: #2A2A2D; font-weight: bold;">
                                                    <i class="fa fa-hammer me-2" style="color: #FF914D;"/> Materiales generales
                                                </h3>
                                                <ul style="font-family: 'Poppins', sans-serif; padding-left: 1.5rem;">
                                                    <li>Maquinarias</li>
                                                    <li>Pinturas y revestimientos</li>
                                                    <li>Herramientas de mano</li>
                                                    <li>Aislantes, impermeabilizantes</li>
                                                    <li>Elementos de seguridad industrial</li>
                                                </ul>
                                                <div style="margin-top: 20px; text-align: center;">
                                                    <div style="color: #FF914D; font-weight: 700; font-size: 2rem; font-family: 'Poppins', sans-serif;">2K+</div>
                                                    <div style="font-family: 'Poppins', sans-serif;">Productos</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 pt16 pb16">
                                        <div style="box-shadow: 0 15px 35px rgba(0,0,0,0.08); border-radius: 16px; background-color: #FFFFFF; height: 100%; transform: translateY(15px);" class="card">
                                            <div class="card-body">
                                                <h3 style="font-family: 'Poppins', sans-serif; color: #2A2A2D; font-weight: bold;">
                                                    <i class="fa fa-tools me-2" style="color: #FF914D;"/> Servicios adicionales
                                                </h3>
                                                <ul style="font-family: 'Poppins', sans-serif; padding-left: 1.5rem;">
                                                    <li>Asesoramiento técnico</li>
                                                    <li>Armado de presupuestos para obras</li>
                                                    <li>Entrega a domicilio (zonas cercanas)</li>
                                                </ul>
                                                <div style="margin-top: 20px; text-align: center;">
                                                    <div style="color: #FF914D; font-weight: 700; font-size: 2rem; font-family: 'Poppins', sans-serif;">24/7</div>
                                                    <div style="font-family: 'Poppins', sans-serif;">Soporte Técnico</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- NUEVA SECCIÓN: Marcas con las que trabajamos (Carrusel) -->
                            <div class="s_carousel pt32 pb32 mt-4" data-snippet="s_carousel" data-name="Carousel" style="background-color: #FFFFFF !important; border-radius: 16px; box-shadow: 0 15px 35px rgba(0,0,0,0.03);">
                                <div class="s_title pb16" data-name="Title">
                                    <h2 style="text-align: center; font-family: 'Poppins', sans-serif;">
                                        <span style="background-color: rgba(255,145,77,0.1); color: #FF914D; padding: 8px 20px; border-radius: 50px; font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 1rem; text-transform: uppercase;">
                                            NUESTRAS MARCAS
                                        </span>
                                    </h2>
                                    <h3 class="mt-3" style="text-align: center; font-family: 'Poppins', sans-serif; color: #2A2A2D; font-weight: bold; font-size: 2.5rem">
                                        Trabajamos con las <span style="color: #FF914D;">mejores marcas</span>
                                    </h3>
                                </div>
                                
                                <!-- Carrusel de marcas dinámico -->
                                <div id="carouselBrands" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000" style="padding: 30px 20px;">
                                    <div class="carousel-inner">
                                        <!-- Primera slide -->
                                        <div class="carousel-item active">
                                            <div class="row justify-content-center align-items-center">
                                                <t t-foreach="request.env['product.brand'].sudo().search([], limit=4)" t-as="brand">
                                                    <div class="col-6 col-md-3 text-center py-3">
                                                        <a t-att-href="'/shop?brand=%s' % brand.id" class="d-block" style="text-decoration: none;">
                                                            <img t-att-src="'/web/image/product.brand/%s/logo' % brand.id" t-att-alt="brand.name" class="img-fluid mx-auto" style="max-height: 80px; filter: grayscale(100%); opacity: 0.6; transition: all 0.3s ease;" onmouseover="this.style.filter='grayscale(0)'; this.style.opacity='1';" onmouseout="this.style.filter='grayscale(100%)'; this.style.opacity='0.6';"/>
                                                            <h5 class="mt-2 mb-0" style="font-family: 'Poppins', sans-serif; color: #2A2A2D; font-weight: 600; font-size: 1rem;">
                                                                <t t-esc="brand.name"/>
                                                            </h5>
                                                        </a>
                                                    </div>
                                                </t>
                                            </div>
                                        </div>
                                        <!-- Segunda slide (solo se muestra si hay más de 4 marcas) -->
                                        <t t-if="request.env['product.brand'].sudo().search_count([]) &gt; 4">
                                            <div class="carousel-item">
                                                <div class="row justify-content-center align-items-center">
                                                    <t t-foreach="request.env['product.brand'].sudo().search([], offset=4, limit=4)" t-as="brand">
                                                        <div class="col-6 col-md-3 text-center py-3">
                                                            <a t-att-href="'/shop?brand=%s' % brand.id" class="d-block" style="text-decoration: none;">
                                                                <img t-att-src="'/web/image/product.brand/%s/logo' % brand.id" t-att-alt="brand.name" class="img-fluid mx-auto" style="max-height: 80px; filter: grayscale(100%); opacity: 0.6; transition: all 0.3s ease;" onmouseover="this.style.filter='grayscale(0)'; this.style.opacity='1';" onmouseout="this.style.filter='grayscale(100%)'; this.style.opacity='0.6';"/>
                                                                <h5 class="mt-2 mb-0" style="font-family: 'Poppins', sans-serif; color: #2A2A2D; font-weight: 600; font-size: 1rem;">
                                                                    <t t-esc="brand.name"/>
                                                                </h5>
                                                            </a>
                                                        </div>
                                                    </t>
                                                </div>
                                            </div>
                                        </t>
