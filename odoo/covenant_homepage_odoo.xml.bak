                                <!-- Estilos CSS -->
                                <div class="s_text_block pt16 pb16" data-snippet="s_text_block" data-name="Texto Adicional" style="background-color: #FFFFFF !important;">
                                    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&amp;display=swap" rel="stylesheet"/>
                                    <style>
                                        /* Estilos globales */
                                        body {
                                            font-family: 'Poppins', sans-serif;
                                        }
                                        
                                        /* Efectos hover productos */
                                        .oe_product_card:hover {
                                            transform: translateY(-10px) !important;
                                            box-shadow: 0 25px 50px rgba(0,0,0,0.15) !important;
                                            transition: all 0.4s ease !important;
                                        }
                                        
                                        /* Efectos de botones */
                                        .btn:hover {
                                            transform: translateY(-2px) !important;
                                            box-shadow: 0 10px 25px rgba(0,0,0,0.2) !important;
                                            transition: all 0.3s ease !important;
                                        }
                                        
                                        /* Barra de categorías */
                                        .col-lg-2 ul.list-unstyled li a:hover {
                                            background-color: rgba(255,145,77,0.1);
                                            color: #FF914D !important;
                                            transform: translateX(5px);
                                            transition: all 0.3s ease;
                                        }
                                        
                                        /* Responsivo */
                                        @media (max-width: 768px) {
                                            h2, h3 { font-size: 1.8rem !important; }
                                            .card { margin-bottom: 2rem; }
                                            [style*="transform"] { transform: none !important; }
                                        }
                                        
                                        /* Ajustes para la barra lateral */
                                        @media (max-width: 991px) {
                                            .col-lg-2 div[style*="position: sticky"] {
                                                position: static !important;
                                                margin-bottom: 30px;
                                                border-radius: 12px;
                                                border-left: none;
                                                border-top: 4px solid #FF914D;
                                            }
                                            
                                            /* Mejorar acordeón de Bootstrap */
                                            .accordion-button {
                                                padding: 10px 15px !important;
                                            }
                                            
                                            .accordion-button:focus {
                                                box-shadow: none !important;
                                                border-color: #FF914D !important;
                                            }
                                            
                                            .accordion-button:not(.collapsed) {
                                                background-color: rgba(255,145,77,0.05) !important;
                                                color: #FF914D !important;
                                            }
                                            
                                            /* Mejoras de layout para móvil */
                                            .s_text_image .row.g-3 {
                                                margin: 0;
                                            }
                                            
                                            /* Ajustes para botones en móvil */
                                            .btn-sm {
                                                margin-bottom: 8px !important;
                                            }
                                            
                                            /* Testimonios más compactos */
                                            .mb-4.p-3 {
                                                padding: 10px !important;
                                                margin-bottom: 10px !important;
                                            }
                                        }
                                        
                                        /* Ajustes específicos para móvil pequeño */
                                        @media (max-width: 576px) {
                                            .col-lg-2, .col-lg-10 {
                                                padding: 10px !important;
                                            }
                                            
                                            h1, h2 {
                                                font-size: 1.8rem !important;
                                            }
                                            
                                            h3 {
                                                font-size: 1.4rem !important;
                                            }
                                            
                                            .s_call_to_action h3 {
                                                padding-left: 1rem !important;
                                            }
                                            
                                            .s_call_to_action p {
                                                padding-left: 1rem !important;
                                            }
                                        }
                                        
                                        /* Asimetría en las tarjetas */
                                        .card {
                                            transition: all 0.4s ease;
                                        }
                                        
                                        /* Ajustes específicos para container-fluid */
                                        .container-fluid {
                                            max-width: 1920px;
                                            margin: 0 auto;
                                        }
                                    </style>
                                </div>
