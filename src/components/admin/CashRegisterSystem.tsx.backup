          });
        } else {
          console.log('⚠️ No hay reporte activo para actualizar');
          toast({
            title: "⚠️ Sin reporte",
            description: "No hay un reporte de caja activo para actualizar"
          });
        }
      } else {
        console.log('⚠️ NO HAY VENTAS EN LA BASE DE DATOS');
        toast({
          title: "⚠️ Sin datos",
