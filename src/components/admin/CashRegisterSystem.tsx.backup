// Interfaces exportables
export interface CashMovement {
  id: string;
  type: 'sale_cash' | 'payment_cash' | 'entry' | 'exit' | 'return_cash' | 'credit_payment' | 'vault_deposit' | 'bank_transfer' | 'expense' | 'tip' | 'bonus';
  amount: number;
  description: string;
  timestamp: Date;
  userId: string;
  reference?: string;
  category?: string;
  approved?: boolean;
  urgent?: boolean;
}

// Interfaz para ventas del POS
export interface POSSale {
  id: string;
  saleNumber: string;
  customer: {
    name: string;
    phone?: string;
    email?: string;
    clientCode?: string;
  };
  items: Array<{
    product: {
      id: string;
      name: string;
      price: number;
    };
    quantity: number;
    subtotal: number;
  }>;
  subtotal: number;
  discounts: number;
  tax: number;
  total: number;
  paymentMethod: 'cash' | 'card' | 'transfer' | 'mixed' | 'credit';
  paymentDetails?: {
    receivedAmount?: number;
    cardAmount?: number;
    transferAmount?: number;
  };
  status: string;
  timestamp: Date;
  cashier: string;
  mode?: string;
  notes?: string;
  reportId?: string; // ID del reporte de caja al que pertenece esta venta
}

export interface SalesByDepartment {
  department: string;
  totalSales: number;
  cashSales: number;
  creditCardSales: number;
  creditSales: number;
  voucherSales: number;
  returns: number;
  profit: number;
  transactions: number;
  avgTicket: number;
  topProduct: string;
  growth: number;
}

export interface AdvancedMetrics {
  efficiency: number;
  cashFlow: number;
  profitability: number;
  customerSatisfaction: number;
  operationalRisk: number;
  salesVelocity: number;
  inventoryTurn: number;
  avgTransactionTime: number;
}

export interface AlertSystem {
  id: string;
  type: 'warning' | 'error' | 'info' | 'success';
  title: string;
  message: string;
  timestamp: Date;
  resolved: boolean;
  severity: 'low' | 'medium' | 'high' | 'critical';
}

export interface DailyCashReport {
  id: string;
  date: Date;
  openingBalance: number;
  closingBalance: number;
  totalSales: number;
  cashInBox: number;
  
  // Ventas en efectivo avanzadas
  cashSales: number;
  cashPayments: number;
  cashEntries: number;
  cashExits: number;
  cashReturns: number;
  vaultDeposits: number;
  bankTransfers: number;
  
  // Ganancias detalladas
  totalProfit: number;
  grossProfit: number;
  netProfit: number;
  operationalCosts: number;
  
  // Ventas por método expandidas
  creditCardSales: number;
  creditSales: number;
  voucherSales: number;
  salesReturns: number;
  digitalPayments: number;
  
  // Métricas avanzadas
  metrics: AdvancedMetrics;
  
  // Datos expandidos
  departmentSales: SalesByDepartment[];
  cashOutflow: number;
  taxes: number;
  tips: number;
  bonuses: number;
  expenses: number;
  
  movements: CashMovement[];
  alerts: AlertSystem[];
  createdBy: string;
  status: 'open' | 'closed' | 'review' | 'approved';
  shiftStart?: Date;
  shiftEnd?: Date;
  cashierNotes: string;
  managerApproval?: string;
}

// Componente de estadística animada
const AnimatedStat: React.FC<{
  icon: React.ReactNode;
  label: string;
  value: string | number;
  change?: number;
  color: string;
  gradient: string;
  delay?: number;
}> = ({ icon, label, value, change, color, gradient, delay = 0 }) => {
  const [animatedValue, setAnimatedValue] = useState(0);
  const [isVisible, setIsVisible] = useState(false);
  const numericValue = typeof value === 'string' ? parseFloat(value.replace(/[^\d.-]/g, '')) || 0 : value;

  useEffect(() => {
    setTimeout(() => setIsVisible(true), delay);
    
    if (isVisible && numericValue > 0) {
      const duration = 2000;
      const steps = 60;
      const stepValue = numericValue / steps;
      let currentStep = 0;

      const timer = setInterval(() => {
        currentStep++;
        setAnimatedValue(Math.min(stepValue * currentStep, numericValue));
        
        if (currentStep >= steps) {
          clearInterval(timer);
        }
      }, duration / steps);

      return () => clearInterval(timer);
    }
  }, [isVisible, numericValue]);

  return (
    <div className={`transform transition-all duration-1000 ${isVisible ? 'translate-y-0 opacity-100' : 'translate-y-8 opacity-0'}`}>
      <Card className={`relative overflow-hidden border-0 shadow-xl bg-gradient-to-br ${gradient} hover:scale-105 transition-all duration-300 cursor-pointer group`}>
        <div className="absolute inset-0 bg-white/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        <CardContent className="p-6 relative z-10">
          <div className="flex items-center justify-between mb-4">
            <div className={`p-3 rounded-full bg-white/20 backdrop-blur-sm ${color} shadow-lg`}>
              {React.cloneElement(icon as React.ReactElement, { className: "h-6 w-6 text-white" })}
            </div>
            {change !== undefined && (
              <div className={`flex items-center space-x-1 ${change >= 0 ? 'text-green-100' : 'text-red-100'}`}>
                {change >= 0 ? <TrendingUp className="h-4 w-4" /> : <TrendingDown className="h-4 w-4" />}
                <span className="text-sm font-medium">{change > 0 ? '+' : ''}{change.toFixed(1)}%</span>
              </div>
            )}
          </div>
          <div>
            <p className="text-sm font-medium text-white/80">{label}</p>
            <p className="text-3xl font-bold text-white mt-1">
              {typeof value === 'string' && value.startsWith('$') 
                ? `$${Math.round(animatedValue).toLocaleString()}`
                : typeof value === 'number' 
                  ? Math.round(animatedValue).toLocaleString()
                  : value
              }
            </p>
          </div>
          <div className="absolute -top-10 -right-10 w-20 h-20 bg-white/10 rounded-full blur-xl"></div>
          <div className="absolute -bottom-5 -left-5 w-15 h-15 bg-white/5 rounded-full blur-lg"></div>
        </CardContent>
      </Card>
    </div>
  );
};

// Componente de gráfico circular animado
const AnimatedCircularProgress: React.FC<{
  percentage: number;
  label: string;
  color: string;
  size?: number;
}> = ({ percentage, label, color, size = 120 }) => {
  const [animatedPercentage, setAnimatedPercentage] = useState(0);
  const circumference = 2 * Math.PI * (size / 2 - 10);

  useEffect(() => {
    const timer = setTimeout(() => {
      setAnimatedPercentage(percentage);
    }, 500);
    return () => clearTimeout(timer);
  }, [percentage]);

  return (
    <div className="flex flex-col items-center space-y-2">
      <div className="relative">
        <svg width={size} height={size} className="transform -rotate-90">
          <circle
            cx={size / 2}
            cy={size / 2}
            r={size / 2 - 10}
            stroke="currentColor"
            strokeWidth="8"
            fill="transparent"
            className="text-gray-200"
          />
          <circle
            cx={size / 2}
            cy={size / 2}
            r={size / 2 - 10}
            stroke="currentColor"
            strokeWidth="8"
            fill="transparent"
            strokeDasharray={circumference}
            strokeDashoffset={circumference - (animatedPercentage / 100) * circumference}
            className={`${color} transition-all duration-1000 ease-out drop-shadow-lg`}
            strokeLinecap="round"
          />
        </svg>
        <div className="absolute inset-0 flex items-center justify-center">
          <span className="text-2xl font-bold text-gray-800">{Math.round(animatedPercentage)}%</span>
        </div>
      </div>
      <span className="text-sm font-medium text-gray-600 text-center">{label}</span>
    </div>
  );
};

// Componente de alerta avanzada
const AdvancedAlert: React.FC<{ alert: AlertSystem; onResolve: (id: string) => void }> = ({ alert, onResolve }) => {
  const severityColors = {
    low: 'bg-blue-50 border-blue-200 text-blue-800',
    medium: 'bg-yellow-50 border-yellow-200 text-yellow-800',
    high: 'bg-orange-50 border-orange-200 text-orange-800',
    critical: 'bg-red-50 border-red-200 text-red-800 animate-pulse'
  };

  const severityIcons = {
    low: <Bell className="h-5 w-5" />,
    medium: <AlertCircle className="h-5 w-5" />,
    high: <Zap className="h-5 w-5" />,
    critical: <Flame className="h-5 w-5" />
  };

  return (
    <div className={`p-4 rounded-lg border-l-4 ${severityColors[alert.severity]} transition-all duration-300 hover:shadow-lg`}>
      <div className="flex items-start justify-between">
        <div className="flex items-center space-x-3">
          {severityIcons[alert.severity]}
          <div>
            <h4 className="font-semibold">{alert.title}</h4>
            <p className="text-sm opacity-80">{alert.message}</p>
            <p className="text-xs opacity-60 mt-1">{alert.timestamp.toLocaleString()}</p>
          </div>
        </div>
        {!alert.resolved && (
          <Button
            size="sm"
            variant="outline"
            onClick={() => onResolve(alert.id)}
            className="shrink-0"
          >
            <CheckCircle className="h-4 w-4 mr-1" />
            Resolver
          </Button>
        )}
      </div>
    </div>
  );
};

export const CashRegisterSystem: React.FC = () => {
  const [currentReport, setCurrentReport] = useState<DailyCashReport | null>(null);
  const [reports, setReports] = useState<DailyCashReport[]>([]);
  const [loadingReports, setLoadingReports] = useState(true);
  const [isCreatingReport, setIsCreatingReport] = useState(false);
  const [selectedDate, setSelectedDate] = useState(new Date().toISOString().split('T')[0]);
  const [activeTab, setActiveTab] = useState('dashboard');
  const [liveMode, setLiveMode] = useState(false);
  const [soundEnabled, setSoundEnabled] = useState(true);
  const [autoRefresh, setAutoRefresh] = useState(true);
  const [daySales, setDaySales] = useState<POSSale[]>([]);
  const [allSales, setAllSales] = useState<POSSale[]>([]);
  const [loadingSales, setLoadingSales] = useState(false);
  const [expandedSales, setExpandedSales] = useState<{[key: string]: boolean}>({});
  const [salesFilter, setSalesFilter] = useState<'all' | 'today' | 'date'>('date');
  const { user } = useAuth();

  // Estados para efectos espectaculares
  const [showSuccess, setShowSuccess] = useState(false);
  const [showCelebration, setShowCelebration] = useState(false);
  const [showLoading, setShowLoading] = useState(false);
  const [currentTime, setCurrentTime] = useState(new Date());
  const soundEffects = useSoundEffects();

  // Estados para movimientos manuales con categorías
  const [manualMovement, setManualMovement] = useState({
    type: 'entry' as CashMovement['type'],
    amount: 0,
    description: '',
    reference: '',
    category: '',
    urgent: false
  });

  // Categorías expandidas
  const [departments] = useState([
    'Electrónicos', 'Ropa', 'Alimentación', 'Hogar', 'Deportes', 
    'Libros', 'Farmacia', 'Belleza', 'Juguetes', 'Automotriz', 
    'Jardinería', 'Mascotas', 'Tecnología', 'Otros'
  ]);

  const movementCategories = [
    'Operacional', 'Mantenimiento', 'Suministros', 'Servicios',
    'Emergencia', 'Promocional', 'Administrativo', 'Personal'
  ];

  // Actualizar hora cada segundo
  useEffect(() => {
    const timer = setInterval(() => setCurrentTime(new Date()), 1000);
    return () => clearInterval(timer);
  }, []);

  // Cargar reportes desde Firebase con actualización en tiempo real
  useEffect(() => {
    console.log('🔄 [INIT] Inicializando sistema de corte de caja...');
    console.log('📅 [INIT] Fecha seleccionada:', selectedDate);
    console.log('⚡ [INIT] Live mode:', liveMode);
    
    const initializeSystem = async () => {
      if (!liveMode) {
        await fetchReports();
        await loadTodayReport();
        await fetchDaySales(new Date(selectedDate));
        
        // Forzar sincronización inmediata después de cargar
        setTimeout(async () => {
          console.log('🔄 [INIT] Ejecutando sincronización forzada inicial...');
          await loadTodayReport();
        }, 2000);
      } else {
        // Modo en tiempo real
        const unsubscribe = onSnapshot(
          query(collection(db, "cash_reports"), orderBy("date", "desc")),
          (snapshot) => {
            const reportsData = snapshot.docs.map(doc => {
              const data = doc.data();
              return {
                id: doc.id,
                ...data,
                date: data.date?.toDate() || new Date(),
                movements: data.movements || [],
                alerts: data.alerts || []
              } as DailyCashReport;
            });
            setReports(reportsData);
            
            // Encontrar reporte actual
            const today = new Date(selectedDate);
            const todayReport = reportsData.find(report => 
              report.date.toDateString() === today.toDateString()
            );
            if (todayReport) {
              setCurrentReport(todayReport);
              
              // Sincronizar ventas del POS en tiempo real
              console.log('🔄 [LIVE MODE] Sincronizando ventas del POS...');
              fetchRealSalesData(today).then(realSalesData => {
                if (realSalesData.totalSales > 0) {
                  console.log('📊 [LIVE MODE] Ventas encontradas, actualizando reporte...');
                  // Actualizar el reporte con las ventas reales
                  setCurrentReport(prev => prev ? {
                    ...prev,
                    totalSales: realSalesData.totalSales,
                    cashSales: realSalesData.cashSales,
                    creditCardSales: realSalesData.creditCardSales,
                    creditSales: realSalesData.creditSales,
                    digitalPayments: realSalesData.transferSales,
                    cashInBox: prev.openingBalance + realSalesData.cashSales,
                    movements: [
                      ...prev.movements.filter(m => m.type !== 'sale_cash'),
                      ...realSalesData.movements
                    ]
                  } : null);
                }
              }).catch(error => {
                console.error('❌ [LIVE MODE] Error sincronizando ventas:', error);
              });
              
              // Efectos de sonido y visuales
              if (soundEnabled && todayReport.movements.length > (currentReport?.movements.length || 0)) {
                playNotificationSound();
              }
            }
          }
        );
        return () => unsubscribe();
      }
    };
    
    initializeSystem();
  }, [selectedDate, liveMode, soundEnabled]);

  // Forzar sincronización cuando cambie la fecha seleccionada
  useEffect(() => {
    console.log('📅 [DATE CHANGE] Fecha seleccionada cambió:', selectedDate);
    
    // Pequeño delay para asegurar que otros efectos se ejecuten primero
    const syncTimer = setTimeout(async () => {
      if (currentReport) {
        console.log('🔄 [DATE CHANGE] Forzando sincronización de ventas...');
        try {
          await loadTodayReport();
          console.log('✅ [DATE CHANGE] Sincronización completada');
        } catch (error) {
          console.error('❌ [DATE CHANGE] Error en sincronización:', error);
        }
      }
    }, 1000);

    return () => clearTimeout(syncTimer);
  }, [selectedDate]);

  // Auto-actualización de datos de ventas cada 30 segundos
  useEffect(() => {
    if (!autoRefresh || !currentReport) return;

    console.log('🔄 Configurando auto-actualización de datos de ventas cada 10 segundos');
    
    const updateInterval = setInterval(async () => {
      console.log('🔄 Actualizando datos de ventas automáticamente...');
      await loadTodayReport();
    }, 10000); // Cambiar a 10 segundos para más frecuencia

    return () => {
      console.log('🔄 Desactivando auto-actualización de datos de ventas');
      clearInterval(updateInterval);
    };
  }, [autoRefresh, currentReport, selectedDate]);

  // Sincronización inmediata cuando cambia currentReport
  useEffect(() => {
    if (!currentReport) return;

    console.log('📊 [REPORT CHANGED] Reporte cargado, sincronizando ventas...');
    
    // Ejecutar sincronización inmediata
    const syncTimer = setTimeout(async () => {
      try {
        const today = new Date(selectedDate);
        const realSalesData = await fetchRealSalesData(today);
        
        if (realSalesData.totalSales > 0 || realSalesData.movements.length > 0) {
          console.log('💰 [IMMEDIATE SYNC] Aplicando datos de ventas al reporte:', {
            totalSales: realSalesData.totalSales,
            cashSales: realSalesData.cashSales,
            movimientos: realSalesData.movements.length
          });
          
          // Actualizar el reporte con los datos reales
          const updatedReport = {
            ...currentReport,
            totalSales: realSalesData.totalSales,
            cashSales: realSalesData.cashSales,
            creditCardSales: realSalesData.creditCardSales,
            creditSales: realSalesData.creditSales,
            digitalPayments: realSalesData.transferSales,
            cashInBox: currentReport.openingBalance + realSalesData.cashSales,
            movements: [
              ...currentReport.movements.filter(m => m.type !== 'sale_cash'),
              ...realSalesData.movements
            ],
            taxes: realSalesData.totalTax,
            closingBalance: currentReport.openingBalance + realSalesData.cashSales + 
                           (currentReport.cashEntries || 0) - (currentReport.cashExits || 0)
          };

          // Actualizar estado local inmediatamente
          setCurrentReport(updatedReport);
          
          // Guardar en Firebase
          try {
            await updateDoc(doc(db, "cash_reports", currentReport.id), {
              totalSales: updatedReport.totalSales,
              cashSales: updatedReport.cashSales,
              creditCardSales: updatedReport.creditCardSales,
              creditSales: updatedReport.creditSales,
              digitalPayments: updatedReport.digitalPayments,
              cashInBox: updatedReport.cashInBox,
              movements: updatedReport.movements.map(m => ({
                ...m,
                timestamp: Timestamp.fromDate(m.timestamp)
              })),
              taxes: updatedReport.taxes,
              closingBalance: updatedReport.closingBalance,
              lastUpdated: Timestamp.now()
            });
            console.log('✅ [IMMEDIATE SYNC] Reporte actualizado en Firebase');
          } catch (updateError) {
            console.error('❌ [IMMEDIATE SYNC] Error actualizando Firebase:', updateError);
          }
        }
      } catch (error) {
        console.error('❌ [IMMEDIATE SYNC] Error en sincronización:', error);
      }
    }, 1000);

    return () => clearTimeout(syncTimer);
  }, [currentReport?.id, selectedDate]);

  // Listener automático para sincronizar ventas del POS con el corte de caja
  useEffect(() => {
    if (!currentReport || currentReport.status === 'closed') return;

    console.log('🔄 Configurando sincronización automática de ventas...');
    
    const today = new Date(selectedDate);
    const startOfDay = new Date(today);
    startOfDay.setHours(0, 0, 0, 0);
    
    const endOfDay = new Date(today);
    endOfDay.setHours(23, 59, 59, 999);

    // Listener para nuevas ventas del POS
    const unsubscribe = onSnapshot(
      query(
        collection(db, 'pos_sales'),
        where('timestamp', '>=', Timestamp.fromDate(startOfDay)),
        where('timestamp', '<=', Timestamp.fromDate(endOfDay)),
        orderBy('timestamp', 'desc')
      ),
      (snapshot) => {
        snapshot.docChanges().forEach(async (change) => {
          if (change.type === 'added') {
            const saleData = change.doc.data();
            const sale = {
              id: change.doc.id,
              ...saleData,
              timestamp: saleData.timestamp?.toDate() || new Date(),
            } as POSSale;
            
            console.log('💰 Nueva venta detectada - Sincronizando con corte de caja:', sale.saleNumber || sale.id);
            
            // Verificar si ya está registrada
            const existingMovement = currentReport.movements.find(m => 
              m.reference === (sale.saleNumber || sale.id) || m.id === `sale_${sale.id}`
            );

            if (!existingMovement) {
              // Sincronizar automáticamente
              await syncSaleWithCashRegister(sale);
            }
          }
        });
      },
      (error) => {
        console.error('❌ Error en listener de ventas:', error);
      }
    );

    return () => {
      console.log('🔄 Desactivando sincronización automática de ventas');
      unsubscribe();
    };
  }, [currentReport, selectedDate]);

  // Efecto para cargar ventas cuando cambie la fecha
  useEffect(() => {
    console.log('📅 Fecha seleccionada cambió a:', selectedDate);
    // Solo cargar ventas filtradas si el filtro está en 'date'
    if (salesFilter === 'date') {
      fetchDaySales(new Date(selectedDate));
    }
  }, [selectedDate, salesFilter]);

  // Efecto inicial para cargar todas las ventas
  useEffect(() => {
    console.log('🚀 Cargando ventas iniciales...');
    fetchDaySales(); // Sin parámetro = todas las ventas
  }, []);

  // Función para sincronizar ventas en tiempo real
  const syncSaleWithCashRegister = async (saleData: POSSale) => {
    if (!currentReport || currentReport.status === 'closed') {
      console.log('⚠️ No hay reporte de caja activo o está cerrado');
      return;
    }

    try {
      console.log('🔄 Sincronizando nueva venta con corte de caja:', saleData.saleNumber);

      // Crear movimiento de efectivo si es pago en efectivo
      let newMovement: CashMovement | null = null;
      let cashAmount = 0;

      switch (saleData.paymentMethod) {
        case 'cash':
          cashAmount = saleData.total;
          newMovement = {
            id: `sale_${saleData.id}`,
            type: 'sale_cash',
            amount: saleData.total,
            description: `Venta ${saleData.saleNumber} - Cliente: ${saleData.customer?.name || 'N/A'}`,
            timestamp: saleData.timestamp,
            userId: saleData.cashier || 'POS',
            reference: saleData.saleNumber,
            category: 'ventas'
          };
          break;
        case 'mixed':
          const paymentDetails = saleData.paymentDetails || {};
          cashAmount = paymentDetails.receivedAmount || 0;
          if (cashAmount > 0) {
            newMovement = {
              id: `sale_cash_${saleData.id}`,
              type: 'sale_cash',
              amount: cashAmount,
              description: `Venta Mixta ${saleData.saleNumber} (Efectivo) - Cliente: ${saleData.customer?.name || 'N/A'}`,
              timestamp: saleData.timestamp,
              userId: saleData.cashier || 'POS',
              reference: saleData.saleNumber,
              category: 'ventas'
            };
          }
          break;
      }

      // Actualizar el reporte actual
      const updatedReport = {
        ...currentReport,
        totalSales: currentReport.totalSales + saleData.total,
        cashInBox: currentReport.cashInBox + cashAmount,
        closingBalance: currentReport.closingBalance + cashAmount,
        taxes: currentReport.taxes + (saleData.tax || 0),
        movements: newMovement ? [...currentReport.movements, newMovement] : currentReport.movements
      };

      // Actualizar según método de pago
      switch (saleData.paymentMethod) {
        case 'cash':
          updatedReport.cashSales += saleData.total;
          break;
        case 'card':
          updatedReport.creditCardSales += saleData.total;
          break;
        case 'transfer':
          updatedReport.digitalPayments += saleData.total;
          break;
        case 'credit':
          updatedReport.creditSales += saleData.total;
          break;
        case 'mixed':
          const details = saleData.paymentDetails || {};
          updatedReport.cashSales += (details.receivedAmount || 0);
          updatedReport.creditCardSales += (details.cardAmount || 0);
          updatedReport.digitalPayments += (details.transferAmount || 0);
          break;
      }

      // Guardar en Firebase
      await updateDoc(doc(db, "cash_reports", currentReport.id), {
        totalSales: updatedReport.totalSales,
        cashSales: updatedReport.cashSales,
        creditCardSales: updatedReport.creditCardSales,
        creditSales: updatedReport.creditSales,
        digitalPayments: updatedReport.digitalPayments,
        cashInBox: updatedReport.cashInBox,
        closingBalance: updatedReport.closingBalance,
        taxes: updatedReport.taxes,
        movements: updatedReport.movements.map(m => ({
          ...m,
          timestamp: Timestamp.fromDate(m.timestamp)
        })),
        lastUpdated: Timestamp.now()
      });

      // Actualizar estado local
      setCurrentReport(updatedReport);

      console.log('✅ Venta sincronizada con corte de caja exitosamente');

      // Mostrar notificación
      toast({
        title: "💰 Venta registrada",
        description: `Venta ${saleData.saleNumber} agregada al corte de caja - $${saleData.total.toLocaleString()}`,
      });

    } catch (error) {
      console.error('❌ Error sincronizando venta con corte de caja:', error);
    }
  };

  // Función para obtener ventas reales del día desde POS
  // Función simple para sincronizar daySales con currentReport
  const syncReportWithDaySales = async () => {
    console.log('🔄 SINCRONIZACIÓN SIMPLE: daySales → currentReport');
    
    if (!currentReport) {
      console.log('❌ No hay currentReport para actualizar');
      return;
    }

    if (daySales.length === 0) {
      console.log('⚠️ No hay daySales para sincronizar');
      return;
    }

    try {
      console.log('📊 daySales encontradas:', daySales.length);
      console.log('💰 Total en daySales:', daySales.reduce((sum, sale) => sum + sale.total, 0));

      // Calcular totales desde daySales
      const totalSales = daySales.reduce((sum, sale) => sum + sale.total, 0);
      let cashSales = 0;
      let creditCardSales = 0;
      let creditSales = 0;
      let transferSales = 0;

      daySales.forEach(sale => {
        switch (sale.paymentMethod) {
          case 'cash':
            cashSales += sale.total;
            break;
          case 'card':
            creditCardSales += sale.total;
            break;
          case 'credit':
            creditSales += sale.total;
            break;
          case 'transfer':
            transferSales += sale.total;
            break;
          case 'mixed':
            // Para pagos mixtos, dividir según paymentDetails
            const details = sale.paymentDetails || {};
            cashSales += details.receivedAmount || 0;
            creditCardSales += details.cardAmount || 0;
            transferSales += details.transferAmount || 0;
            break;
        }
      });

      console.log('💰 Totales calculados:', {
        totalSales,
        cashSales,
        creditCardSales,
        creditSales,
        transferSales
      });

      // Actualizar currentReport
      const updatedReport = {
        ...currentReport,
        totalSales,
        cashSales,
        creditCardSales,
        creditSales,
        digitalPayments: transferSales,
        cashInBox: currentReport.openingBalance + cashSales,
        closingBalance: currentReport.openingBalance + cashSales,
        lastUpdated: new Date()
      };

      console.log('📋 Actualizando currentReport...');
      setCurrentReport(updatedReport);

      // Actualizar en Firebase
      const reportRef = doc(db, 'cash_reports', currentReport.id);
      await updateDoc(reportRef, {
        totalSales,
        cashSales,
        creditCardSales,
        creditSales,
        digitalPayments: transferSales,
        cashInBox: updatedReport.cashInBox,
        closingBalance: updatedReport.closingBalance,
        lastUpdated: Timestamp.now()
      });

      console.log('✅ Sincronización completada exitosamente');
      
      toast({
        title: "✅ Sincronización completada",
        description: `Se sincronizaron ${daySales.length} ventas por un total de $${totalSales.toLocaleString()}`,
      });

    } catch (error) {
      console.error('❌ Error en sincronización simple:', error);
      toast({
        title: "❌ Error de sincronización",
        description: "No se pudo sincronizar las ventas con el reporte",
        variant: "destructive"
      });
    }
  };

  // Función para forzar sincronización manual inmediata
  const forceSyncSales = async () => {
    console.log('🔄 FORZANDO SINCRONIZACIÓN MANUAL...');
    
    if (!currentReport) {
      console.log('⚠️ No hay reporte activo');
      return;
    }

    try {
      // Usar las ventas ya cargadas en daySales
      console.log('📋 Usando ventas del día ya cargadas:', daySales.length);
      
      if (daySales.length === 0) {
        console.log('⚠️ No hay ventas para sincronizar');
        return;
      }

      // Calcular totales desde daySales
      const totalSales = daySales.reduce((sum, sale) => sum + (sale.total || 0), 0);
      const cashSales = daySales.filter(s => s.paymentMethod === 'cash' || s.paymentMethod === 'efectivo').reduce((sum, sale) => sum + (sale.total || 0), 0);
      const cardSales = daySales.filter(s => s.paymentMethod === 'card' || s.paymentMethod === 'tarjeta').reduce((sum, sale) => sum + (sale.total || 0), 0);
      const creditSales = daySales.filter(s => s.paymentMethod === 'credit' || s.paymentMethod === 'credito').reduce((sum, sale) => sum + (sale.total || 0), 0);
      const digitalSales = daySales.filter(s => s.paymentMethod === 'digital').reduce((sum, sale) => sum + (sale.total || 0), 0);

      console.log('💰 Totales calculados:', { totalSales, cashSales, cardSales, creditSales, digitalSales });

      // Actualizar el reporte actual
      const updatedReport = {
        ...currentReport,
        totalSales,
        cashSales,
        cardSales: cardSales,
        creditSales,
        digitalSales,
        cashInBox: currentReport.openingBalance + cashSales - currentReport.cashExits,
        updatedAt: new Date()
      };

      // Guardar en Firebase
      await updateDoc(doc(db, 'cash_reports', currentReport.id), {
        totalSales,
        cashSales,
        cardSales,
        creditSales,
        digitalSales,
        cashInBox: currentReport.openingBalance + cashSales - currentReport.cashExits,
        updatedAt: serverTimestamp()
      });

      // Actualizar estado local
      setCurrentReport(updatedReport);
      
      console.log('✅ Sincronización completada exitosamente');
      showSuccessNotification();
    } catch (error) {
      console.error('❌ Error en sincronización manual:', error);
    }
  };

  // Función para obtener datos reales de ventas
  const fetchRealSalesData = async (date: Date) => {
    try {
      // Normalizar fecha para búsqueda (eliminar tiempo)
      const startOfDay = new Date(date);
      startOfDay.setHours(0, 0, 0, 0);
      const endOfDay = new Date(date);
      endOfDay.setHours(23, 59, 59, 999);

      console.log('🔍 Buscando ventas para:', date.toLocaleDateString(), 'Rango:', startOfDay, 'a', endOfDay);

      const salesQuery = query(
        collection(db, 'pos_sales'),
        where('timestamp', '>=', Timestamp.fromDate(startOfDay)),
        where('timestamp', '<=', Timestamp.fromDate(endOfDay)),
        orderBy('timestamp', 'desc')
      );

      const salesSnapshot = await getDocs(salesQuery);
      const salesData = salesSnapshot.docs.map(doc => {
        const data = doc.data();
        return {
          id: doc.id,
          ...data,
          timestamp: data.timestamp?.toDate ? data.timestamp.toDate() : new Date(data.timestamp),
        } as POSSale;
      });

      console.log('📊 Ventas encontradas:', salesData.length);

      // Calcular totales
      const totals = {
        totalSales: 0,
        cashSales: 0,
        cardSales: 0,
        creditSales: 0,
        digitalSales: 0,
        salesCount: salesData.length,
        movements: [] as CashMovement[]
      };

      salesData.forEach(sale => {
        const saleTotal = sale.total || 0;
        totals.totalSales += saleTotal;

        switch (sale.paymentMethod) {
          case 'cash':
            totals.cashSales += saleTotal;
            break;
          case 'card':
            totals.cardSales += saleTotal;
            break;
          case 'credit':
            totals.creditSales += saleTotal;
            break;
          case 'transfer':
            totals.digitalSales += saleTotal;
            break;
        }
      });

      return totals;
    } catch (error) {
      console.error('❌ Error obteniendo datos de ventas:', error);
      return {
        totalSales: 0,
        cashSales: 0,
        cardSales: 0,
        creditSales: 0,
        digitalSales: 0,
        salesCount: 0,
        movements: []
      };
    }
  };

  // Funciones auxiliares para formateo y utilidades  
  const formatCurrency = (value: number | undefined): string => {
    return (value || 0).toLocaleString();
  };

  const formatDate = (date: Date): string => {
    return date.toLocaleDateString('es-ES', {
      weekday: 'long',
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    });
  };

  // Obtener métricas avanzadas para dashboard
  const getCurrentAdvancedMetrics = useMemo(() => {
    if (!currentReport) return null;

    const totalIncome = currentReport.totalSales + currentReport.cashEntries;
    const totalOutflow = currentReport.cashExits + currentReport.cashReturns + currentReport.expenses;
    const netFlow = totalIncome - totalOutflow;
    const expectedBalance = currentReport.openingBalance + netFlow;
    const updatedMetrics = calculateAdvancedMetrics(currentReport);

    return {
      netFlow,
      expectedBalance,
      variance: currentReport.cashInBox - expectedBalance,
      efficiency: updatedMetrics.efficiency,
      totalTransactions: currentReport.movements.length,
      avgTransactionValue: currentReport.totalSales / Math.max(1, currentReport.movements.length),
      peakHour: getCurrentPeakHour(currentReport.movements),
      ...updatedMetrics
    };
  }, [currentReport]);
        const data = doc.data();
        const timestamp = data.timestamp?.toDate ? data.timestamp.toDate() : new Date(data.timestamp);
        
        return {
          id: doc.id,
          saleNumber: data.saleNumber,
          total: data.total,
          timestamp,
        };
      });

      console.log(`📦 Total ventas para filtrar: ${allSales.length}`);

      // Aplicar filtro
