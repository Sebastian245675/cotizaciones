            cashInBox: currentReport.openingBalance + realData.cashSales,
            closingBalance: currentReport.openingBalance + realData.cashSales
          };
          
          console.log('📝 DATOS DE ACTUALIZACIÓN:', {
            totalSalesAntes: currentReport.totalSales,
            totalSalesDespues: updatedReport.totalSales,
            cashSalesAntes: currentReport.cashSales,
            cashSalesDespues: updatedReport.cashSales,
            movimientosAntes: currentReport.movements.length,
            movimientosDespues: updatedReport.movements.length
          });
          
          setCurrentReport(updatedReport);
          
          // Guardar en Firebase
          await updateDoc(doc(db, "cash_reports", currentReport.id), {
            totalSales: updatedReport.totalSales,
            cashSales: updatedReport.cashSales,
            creditCardSales: updatedReport.creditCardSales,
            creditSales: updatedReport.creditSales,
            digitalPayments: updatedReport.digitalPayments,
            cashInBox: updatedReport.cashInBox,
            closingBalance: updatedReport.closingBalance,
            movements: updatedReport.movements.map(m => ({
              ...m,
              timestamp: Timestamp.fromDate(m.timestamp)
            })),
            lastUpdated: Timestamp.now()
          });
          
          console.log('✅ REPORTE ACTUALIZADO EXITOSAMENTE');
          toast({
            title: "✅ Diagnóstico Completado",
            description: `Se encontraron ${realData.salesCount} ventas y se actualizó el reporte con $${realData.totalSales.toLocaleString()}`
          });
          
        } else if (realData.totalSales === 0) {
          console.log('⚠️ fetchRealSalesData no encontró ventas para procesar');
          toast({
            title: "⚠️ Sin ventas",
