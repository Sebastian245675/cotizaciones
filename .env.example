# API Keys para IA - Copia este archivo como .env y agrega tus keys reales

# OpenAI API Key (para Vite/React)
VITE_OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI API Key (para Node.js/servidores)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key  
REACT_APP_ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# WhatsApp Service (si es necesario)
REACT_APP_WHATSAPP_API_URL=http://localhost:3001

# Firebase Admin SDK - NUNCA subir el archivo JSON a Git
# Guardar el archivo en functions/ y referenciarlo aquí
FIREBASE_ADMIN_SDK_PATH=./functions/your-firebase-adminsdk-file.json
