# ================================
# 📧 CONFIGURACIÓN DE EMAIL - POS SYSTEM
# ================================

# Para usar Gmail SMTP necesitas:
# 1. Una cuenta de Gmail
# 2. Activar la verificación en 2 pasos
# 3. Generar una "Contraseña de aplicación" específica
# 4. Usar esa contraseña de aplicación aquí (NO tu contraseña normal)

# Instrucciones para obtener contraseña de aplicación de Gmail:
# 1. Ve a https://myaccount.google.com/
# 2. Selecciona "Seguridad" en el panel izquierdo
# 3. Activa la "Verificación en 2 pasos" si no está activada
# 4. Busca "Contraseñas de aplicación" 
# 5. Genera una nueva contraseña para "Aplicación personalizada"
# 6. Usa esa contraseña de 16 caracteres aquí abajo

# 📧 Configuración de cuenta de Gmail para envío de emails
EMAIL_USER=tu-email@gmail.com
EMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# 👤 Usuario administrador principal (para mapear notificaciones)
ADMIN_EMAIL=admin@tutienda.com
ADMIN_USER_ID=admin-user-firebase-id

# ================================
# OTRAS CONFIGURACIONES EXISTENTES
# ================================

# Base de datos
DATABASE_PATH=./data/pos_local.db

# Puerto del servidor
PORT=3001

# Configuración de CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ================================
# INSTRUCCIONES DE CONFIGURACIÓN
# ================================

# 1. Copia este archivo como .env en la carpeta /backend
# 2. Reemplaza "tu-email@gmail.com" con tu email real
# 3. Reemplaza "xxxx-xxxx-xxxx-xxxx" con tu contraseña de aplicación de Gmail
# 4. Configura el ADMIN_EMAIL con el email del administrador
# 5. Si tienes el Firebase User ID del admin, ponlo en ADMIN_USER_ID

# NOTA IMPORTANTE:
# - NUNCA uses tu contraseña normal de Gmail aquí
# - Solo usa contraseñas de aplicación generadas específicamente
# - Mantén este archivo seguro y no lo subas a repositorios públicos