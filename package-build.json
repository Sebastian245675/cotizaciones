{
  "name": "covenant-pos-desktop",
  "version": "1.0.0",
  "main": "electron-app.js",
  "description": "Covenant POS Desktop Application",
  "author": "Covenant",
  "dependencies": {
    "electron": "^31.0.0",
    "express": "^4.18.0"
  },
  "build": {
    "appId": "com.covenant.pos",
    "productName": "Covenant POS",
    "files": [
      "electron-app.js",
      "simple-server.js",
      "dist/**/*"
    ],
    "directories": {
      "output": "d:/covenant-builds"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "CovenantPOS-Portable.exe"
    }
  }
}